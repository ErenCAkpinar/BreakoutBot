{
  "type": "object",
  "additionalProperties": false,
  "required": ["health", "summary", "observations", "position_reviews"],
  "properties": {
    "health": {"type": "string", "enum": ["ok", "watch", "critical", "no_data"]},
    "summary": {"type": "string", "maxLength": 1200},
    "observations": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbol", "severity", "evidence", "recommendation"],
        "properties": {
          "symbol": {"type": "string", "maxLength": 32},
          "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
          "evidence": {"type": "string", "maxLength": 1200},
          "recommendation": {"type": "string", "maxLength": 1200}
        }
      }
    },
    "position_reviews": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbol", "recommendation", "reason"],
        "properties": {
          "symbol": {"type": "string", "maxLength": 32},
          "recommendation": {"type": "string", "enum": ["KEEP_RULES", "REVIEW", "NO_DATA"]},
          "reason": {"type": "string", "maxLength": 1200}
        }
      }
    }
  }
}
